# Copy to .env for local development. Never commit .env.

# Supabase (Lovable Cloud) — already present in your local .env
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# AI provider. Gemini Flash is recommended: by far the cheapest for clause-level
# work, and it runs locally and in Lovable. Key: https://aistudio.google.com → Get API key.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.7-flash.
GEMINI_MODEL=gemini-3.7-flash

# Alternative provider (used only if GEMINI_API_KEY is absent, or AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Force a provider when several keys are present: gemini | anthropic | lovable
AI_PROVIDER=

# Daily Briefing visual highlights. Images are fetched server-side from the
# official Guardian Content API and shown only when your usage includes image
# rights. Commercial products require an appropriate commercial agreement.
# Set NEWS_VISUALS_PROVIDER=none to disable the server integration entirely.
NEWS_VISUALS_PROVIDER=guardian
GUARDIAN_API_KEY=
GUARDIAN_IMAGE_USAGE_LICENSED=false
